MAINTAINER "caterina.mauri@unibo.it"
INFO       "ParlaTO"
NAME       "ParlaTO"
PATH       '/corpora/ParlaTO/indexed/'
ENCODING   "UTF-8"
LANGUAGE   "Italian"
VERTICAL   '/corpora/ParlaTO/vertical/source'
INFOHREF   "https://www.kiparla.it/"
DOCSTRUCTURE conversation

ATTRIBUTE word
ATTRIBUTE token_id {
    LABEL "Token ID"
}
ATTRIBUTE lemma {
    LABEL "Lemma"
}
ATTRIBUTE upos {
    LABEL "PoS"
}
ATTRIBUTE lc {
    LABEL      "word (lowercase)"
    DYNAMIC    utf8lowercase
    DYNLIB     internal
    ARG1       "C"
    FUNTYPE    s
    FROMATTR   word
    TYPE       index
    TRANSQUERY yes
}

STRUCTURE conversation {
    ATTRIBUTE code {
        LABEL      "Codice conversazione"
    }
    ATTRIBUTE linguistic_annotation {
        LABEL      "Annotazione linguistica"
    }
    ATTRIBUTE full_conversation {
        LABEL      "Trascrizione completa"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE type {
        LABEL      "Tipo di interazione"
    }
    ATTRIBUTE duration {
        LABEL      "Durata"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE participants_number {
        LABEL      "Numero di partecipanti"
    }
    ATTRIBUTE languages {
        LABEL      "Lingue"
        MULTIVALUE "1"
        MULTISEP   ","
    }
    ATTRIBUTE collection_point {
        LABEL      "Luogo di raccolta"
    }
    ATTRIBUTE participants_relationship {
        LABEL      "Rapporto tra i partecipanti"
    }
    ATTRIBUTE moderator {
        LABEL      "Presenza di moderatore"
    }
    ATTRIBUTE year {
        LABEL      "Anno di raccolta"
    }
    ATTRIBUTE topic {
        LABEL      "Argomento"
    }
}

STRUCTURE transcription_unit {
    ATTRIBUTE participant_code {
        LABEL      "Codice partecipante"
    }
    ATTRIBUTE begin {
        LABEL      "Inizio"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE end {
        LABEL      "Fine"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE audio_file {
        LABEL      "Audio"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE report_url {
        LABEL      "Segnala un problema"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE participant_occupation {
        LABEL "Occupazione"
    }
    ATTRIBUTE participant_gender {
        LABEL "Genere"
    }
    ATTRIBUTE participant_birth_region {
        LABEL "Regione di provenienza"
    }
    ATTRIBUTE participant_age_range {
        LABEL "Età"
    }
    ATTRIBUTE participant_study_level {
        LABEL "Titolo di studio"
    }
    DISPLAYTAG 0
    DISPLAYBEGIN "·[%(participant_code)]·"
    DISPLAYEND   ""
    NESTED 1
}

STRUCTURE g {
    DISPLAYTAG 0
    DISPLAYBEGIN "_EMPTY_"
}

STRUCTURE pause {
    DISPLAYTAG   0
    DISPLAYBEGIN "·(.)·"
}

STRUCTURE nvb {
    ATTRIBUTE descr {
        LABEL "Comportamento non verbale"
    }
    DISPLAYTAG   0
    DISPLAYBEGIN "·((%(descr)))·"
}

SUBCORPATTRS "conversation.type,conversation.participants_number,conversation.languages,conversation.collection_point,conversation.linguistic_annotation,conversation.topic,conversation.moderator,conversation.participants_relationship,conversation.year,transcription_unit.participant_code,transcription_unit.participant_occupation,transcription_unit.participant_gender,transcription_unit.participant_birth_region,transcription_unit.participant_age_range,transcription_unit.participant_study_level"
SHORTREF     "=conversation.code"
