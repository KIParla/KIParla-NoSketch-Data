MAINTAINER "caterina.mauri@unibo.it"
INFO       "ParlaBZ"
NAME       "ParlaBZ"
PATH       '/corpora/ParlaBZ/indexed/'
ENCODING   "UTF-8"
LANGUAGE   "Italian"
VERTICAL   '/corpora/ParlaBZ/vertical/source'
INFOHREF   "https://www.kiparla.it/"
DOCSTRUCTURE conversation

ATTRIBUTE word
ATTRIBUTE token_id {
    LABEL "Token ID"
}
ATTRIBUTE lemma {
    LABEL "Lemma"
}
ATTRIBUTE upos {
    LABEL "PoS"
}
ATTRIBUTE variation {
    LABEL "Variazione linguistica (token)"
}
ATTRIBUTE non_standard_form {
    LABEL "Forma emergente/non standard (token)"
}
ATTRIBUTE lc {
    LABEL      "word (lowercase)"
    DYNAMIC    utf8lowercase
    DYNLIB     internal
    ARG1       "C"
    FUNTYPE    s
    FROMATTR   word
    TYPE       index
    TRANSQUERY yes
}

STRUCTURE conversation {
    ATTRIBUTE code {
        LABEL      "Codice conversazione"
    }
    ATTRIBUTE linguistic_annotation {
        LABEL      "Annotazione linguistica"
    }
    ATTRIBUTE full_conversation {
        LABEL      "Trascrizione completa"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE type {
        LABEL      "Tipo di interazione"
    }
    ATTRIBUTE duration {
        LABEL      "Durata"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE duration_range {
        LABEL      "Fascia di durata"
    }
    ATTRIBUTE participants_number {
        LABEL      "Numero di partecipanti"
    }
    ATTRIBUTE participants {
        LABEL      "Partecipanti"
        MULTIVALUE "1"
        MULTISEP   ","
    }
    ATTRIBUTE year {
        LABEL      "Anno di raccolta"
    }
    ATTRIBUTE unknown_participant {
        LABEL      "Partecipante non identificato"
    }
}

STRUCTURE transcription_unit {
    ATTRIBUTE participant_code {
        LABEL      "Codice partecipante"
    }
    ATTRIBUTE begin {
        LABEL      "Inizio"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE end {
        LABEL      "Fine"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE audio_file {
        LABEL      "Audio"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE report_url {
        LABEL      "Segnala un problema"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE participant_occupation {
        LABEL      "Occupazione"
    }
    ATTRIBUTE participant_gender {
        LABEL      "Genere"
    }
    ATTRIBUTE participant_school_region {
        LABEL      "Regione di provenienza (scuola)"
    }
    ATTRIBUTE participant_age_range {
        LABEL      "Età"
    }
    ATTRIBUTE participant_study_level {
        LABEL      "Titolo di studio"
    }
    DISPLAYTAG 0
    DISPLAYBEGIN "·[%(participant_code)]·"
    DISPLAYEND   ""
}

STRUCTURE g {
    DISPLAYTAG 0
    DISPLAYBEGIN "_EMPTY_"
}

STRUCTURE pause {
    DISPLAYTAG   0
    DISPLAYBEGIN "·(.)·"
}

STRUCTURE nvb {
    ATTRIBUTE descr {
        LABEL "Comportamento non verbale"
    }
    DISPLAYTAG   0
    DISPLAYBEGIN "·((%(descr)))·"
}

SUBCORPATTRS "conversation.linguistic_annotation,conversation.type,conversation.duration_range,conversation.participants_number,conversation.participants,conversation.year,conversation.unknown_participant,transcription_unit.participant_code,transcription_unit.participant_occupation,transcription_unit.participant_gender,transcription_unit.participant_school_region,transcription_unit.participant_age_range,transcription_unit.participant_study_level"
SHORTREF     "=conversation.code"
