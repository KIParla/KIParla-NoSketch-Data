MAINTAINER "caterina.mauri@unibo.it"
INFO       "KIP"
NAME       "KIP"
PATH       '/corpora/KIP/indexed/'
ENCODING   "UTF-8"
LANGUAGE   "Italian"
VERTICAL   '/corpora/KIP/vertical/source'
INFOHREF   "https://www.kiparla.it/"
DOCSTRUCTURE conversation

ATTRIBUTE word
ATTRIBUTE token_id {
    LABEL "Token ID"
}
ATTRIBUTE lc {
    LABEL      "word (lowercase)"
    DYNAMIC    utf8lowercase
    DYNLIB     internal
    ARG1       "C"
    FUNTYPE    s
    FROMATTR   word
    TYPE       index
    TRANSQUERY yes
}

STRUCTURE conversation {
    ATTRIBUTE code {
        LABEL      "Codice conversazione"
    }
    ATTRIBUTE full_conversation {
        LABEL      "Trascrizione completa"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE type {
        LABEL      "Tipo di interazione"
    }
    ATTRIBUTE duration {
        LABEL      "Durata"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE participants_number {
        LABEL      "Numero di partecipanti"
    }
    ATTRIBUTE participants_relationship {
        LABEL      "Rapporto tra i partecipanti"
    }
    ATTRIBUTE moderator {
        LABEL      "Presenza di moderatore"
    }
    ATTRIBUTE topic {
        LABEL      "Argomento"
    }
    ATTRIBUTE year {
        LABEL      "Anno di raccolta"
    }
    ATTRIBUTE collection_point {
        LABEL      "Luogo di raccolta"
    }
}

STRUCTURE transcription_unit {
    ATTRIBUTE participant_code {
        LABEL      "Codice partecipante"
    }
    ATTRIBUTE begin {
        LABEL      "Inizio"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE end {
        LABEL      "Fine"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE audio_file {
        LABEL      "Audio"
        MAXLISTSIZE "0"
    }
    ATTRIBUTE participant_occupation {
        LABEL "Occupazione"
    }
    ATTRIBUTE participant_gender {
        LABEL "Genere"
    }
    ATTRIBUTE participant_school_region {
        LABEL "Regione di provenienza"
    }
    ATTRIBUTE participant_age_range {
        LABEL "Età"
    }
    DISPLAYTAG 0
    DISPLAYBEGIN "·[%(participant_code)]·"
    DISPLAYEND   ""
    NESTED 1
}

STRUCTURE g {
    DISPLAYTAG 0
    DISPLAYBEGIN "_EMPTY_"
}

SUBCORPATTRS "conversation.type,conversation.participants_number,conversation.participants_relationship,conversation.moderator,conversation.topic,conversation.year,conversation.collection_point,transcription_unit.participant_code,transcription_unit.participant_occupation,transcription_unit.participant_gender,transcription_unit.participant_school_region,transcription_unit.participant_age_range"
SHORTREF     "=conversation.code"
